<Window x:Class="DeskSpace.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FluxDesk" Height="750" Width="1060" MinWidth="860" MinHeight="560"
        Icon="logo.png"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="Segoe UI" UseLayoutRounding="True"
        StateChanged="Window_StateChanged"
        PreviewKeyDown="Window_PreviewKeyDown">
    
    <Border x:Name="OuterWindowBorder"
            Background="{StaticResource BgDarkBrush}" 
            BorderBrush="{StaticResource BorderBrush}" 
            BorderThickness="1" 
            CornerRadius="12">
        <Grid x:Name="RootClipGrid" SizeChanged="RootClipGrid_SizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown">
                <Border x:Name="TitleBarBg" CornerRadius="11,11,0,0" Background="{StaticResource SidebarBrush}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- App Logo & Title -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                        <Image Source="logo.png" Width="26" Height="26" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="FluxDesk" FontWeight="Bold" FontSize="14.5" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Window Control Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="BtnMinimize" Click="BtnMinimize_Click" Style="{StaticResource WindowCaptionButtonStyle}">
                            <Path Data="{StaticResource IconMinimize}" Fill="{StaticResource TextSecondaryBrush}" Width="11" Height="11" Stretch="Uniform"/>
                        </Button>
                        <Button x:Name="BtnMaximize" Click="BtnMaximize_Click" Style="{StaticResource WindowCaptionButtonStyle}">
                            <Path x:Name="IcoMaximize" Data="{StaticResource IconMaximize}" Fill="{StaticResource TextSecondaryBrush}" Width="10" Height="10" Stretch="Uniform"/>
                        </Button>
                        <Button x:Name="BtnClose" Click="BtnClose_Click" Style="{StaticResource WindowCloseButtonStyle}">
                            <Path Data="{StaticResource IconClose}" Fill="{StaticResource TextSecondaryBrush}" Width="11" Height="11" Stretch="Uniform"/>
                        </Button>
                    </StackPanel>
                </Grid>
                <Border Height="1" VerticalAlignment="Bottom" Background="{StaticResource BorderBrush}"/>
            </Grid>

            <!-- Main Content Area -->
            <Grid x:Name="MainContentGrid" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="225"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Navigation Sidebar -->
                <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" CornerRadius="0,0,0,11">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Navigation Menu (Unique Coherent Architecture) -->
                        <StackPanel Grid.Row="0" Margin="12,18,12,0">
                            <RadioButton x:Name="NavDesktops" GroupName="MainNav" Style="{StaticResource NavRadioButtonStyle}" IsChecked="True" Click="Nav_Click" Tag="0">
                                <StackPanel Orientation="Horizontal">
                                    <Path x:Name="IcoNavDesktops" Data="{StaticResource IconDesktops}" Fill="{StaticResource AccentBrush}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0"/>
                                    <TextBlock x:Name="TxtNavDesktops" Text="Desktops" FontSize="13.5" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavHotkeys" GroupName="MainNav" Style="{StaticResource NavRadioButtonStyle}" Click="Nav_Click" Tag="1">
                                <StackPanel Orientation="Horizontal">
                                    <Path x:Name="IcoNavHotkeys" Data="{StaticResource IconHotkeys}" Fill="{StaticResource TextSecondaryBrush}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0"/>
                                    <TextBlock x:Name="TxtNavHotkeys" Text="Hotkeys" FontSize="13.5" FontWeight="Medium" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <!-- Bottom Settings & About -->
                        <StackPanel Grid.Row="2" Margin="12,0,12,18">
                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,12"/>
                            
                            <RadioButton x:Name="NavSettings" GroupName="MainNav" Style="{StaticResource NavRadioButtonStyle}" Click="Nav_Click" Tag="2">
                                <StackPanel Orientation="Horizontal">
                                    <Path x:Name="IcoNavSettings" Data="{StaticResource IconSettings}" Fill="{StaticResource TextSecondaryBrush}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0"/>
                                    <TextBlock x:Name="TxtNavSettings" Text="Settings" FontSize="13.5" FontWeight="Medium" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavAbout" GroupName="MainNav" Style="{StaticResource NavRadioButtonStyle}" Click="Nav_Click" Tag="3">
                                <StackPanel Orientation="Horizontal">
                                    <Path x:Name="IcoNavAbout" Data="{StaticResource IconAbout}" Fill="{StaticResource TextSecondaryBrush}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0"/>
                                    <TextBlock x:Name="TxtNavAbout" Text="About" FontSize="13.5" FontWeight="Medium" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Right Content Container -->
                <Grid Grid.Column="1" Background="Transparent">
                    <!-- Tab 0: Desktops View -->
                    <Grid x:Name="ViewDesktops" Visibility="Visible" Margin="34,24,34,24">
                        <Grid.RenderTransform>
                            <TranslateTransform Y="0"/>
                        </Grid.RenderTransform>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,18">
                            <TextBlock x:Name="TxtTitleDesktops" Text="Desktops" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>

                            <!-- Normal Actions -->
                            <StackPanel x:Name="NormalDesktopActions" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="BtnEnterSelectMode" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" Click="BtnEnterSelectMode_Click">
                                    <TextBlock x:Name="TxtBtnSelectMode" Text="Select" FontSize="13"/>
                                </Button>
                                <Button Style="{StaticResource AccentButtonStyle}" Click="BtnCreateDesktop_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconPlus}" Fill="#0D1117" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="TxtBtnCreateDesktop" Text="Create Desktop" FontSize="13" FontWeight="Bold" Foreground="#0D1117" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- Bulk Selection Actions -->
                            <StackPanel x:Name="BulkDesktopActions" Visibility="Collapsed" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="BtnSelectAll_Click">
                                    <TextBlock x:Name="TxtBtnSelectAll" Text="Select all" FontSize="12.5"/>
                                </Button>
                                <Button x:Name="BtnDeleteSelected" Style="{StaticResource DangerButtonStyle}" Margin="0,0,8,0" Padding="14,7" Click="BtnDeleteSelected_Click">
                                    <TextBlock x:Name="TxtBtnDeleteSelected" Text="Delete (0)" FontSize="12.5" FontWeight="Bold" Foreground="White"/>
                                </Button>
                                <Button Style="{StaticResource SecondaryButtonStyle}" Click="BtnCancelSelectMode_Click">
                                    <TextBlock x:Name="TxtBtnCancelSelect" Text="Cancel" FontSize="12.5"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Portable Missing-Daemon Warning Banner -->
                        <Border x:Name="DaemonWarningBanner" Grid.Row="1" Visibility="Collapsed" Background="#2D1B1E" BorderBrush="#7F1D1D" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,14">
                            <TextBlock x:Name="TxtDaemonWarning" Text="FluxDeskDaemon.exe was not found next to FluxDesk.exe. Place both files in the same folder for desktop switching &amp; hotkeys." FontSize="12.5" Foreground="#FCA5A5" TextWrapping="Wrap"/>
                        </Border>

                        <!-- Cards Scroll Area -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="ScrollViewer_PreviewMouseWheel" PreviewMouseLeftButtonDown="ScrollViewer_PreviewMouseLeftButtonDown" PreviewKeyDown="ScrollViewer_PreviewKeyDown" RequestBringIntoView="ScrollViewer_RequestBringIntoView">
                            <StackPanel x:Name="DesktopCardsPanel">
                                <!-- Cards populated dynamically from C# -->
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- Tab 1: Hotkeys View -->
                    <Grid x:Name="ViewHotkeys" Visibility="Collapsed" Margin="34,24,34,24">
                        <Grid.RenderTransform>
                            <TranslateTransform Y="0"/>
                        </Grid.RenderTransform>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header with Enabled toggle, Modifier combo and Reset button -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock x:Name="TxtTitleHotkeys" Text="Hotkeys" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="BtnResetHotkeys" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,16,0" Padding="12,6" Click="BtnResetHotkeys_Click">
                                    <TextBlock x:Name="TxtBtnResetHotkeys" Text="Reset to defaults" FontSize="12.5"/>
                                </Button>
                                <TextBlock x:Name="TxtHotkeysEnabled" Text="Enabled" FontSize="13.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <CheckBox x:Name="ChkHotkeysEnabled" Style="{StaticResource ToggleSwitchStyle}" IsChecked="True" VerticalAlignment="Center" Margin="0,0,24,0" Click="ChkHotkeysEnabled_Click"/>
                                <TextBlock x:Name="TxtHotkeysModifier" Text="Modifier" FontSize="13.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox x:Name="CmbHotkeyModifier" Width="116" Height="32" SelectedIndex="0" DropDownOpened="CmbHotkeyModifier_DropDownOpened" SelectionChanged="CmbHotkeyModifier_SelectionChanged">
                                    <ComboBoxItem Content="Alt" Tag="Alt"/>
                                    <ComboBoxItem Content="Ctrl" Tag="Ctrl"/>
                                    <ComboBoxItem Content="Win" Tag="Win"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="TxtHotkeysFeedback" Grid.Row="1" Text="" Visibility="Collapsed" FontSize="12.5" Foreground="#FCA5A5" Margin="0,0,0,12" TextWrapping="Wrap"/>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="ScrollViewer_PreviewMouseWheel" PreviewMouseLeftButtonDown="ScrollViewer_PreviewMouseLeftButtonDown" PreviewKeyDown="ScrollViewer_PreviewKeyDown" RequestBringIntoView="ScrollViewer_RequestBringIntoView">
                            <StackPanel x:Name="HotkeysListPanel" Margin="0,0,10,24">
                                <!-- Populated dynamically from _config.Desktops -->
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- Tab 2: Settings View -->
                    <Grid x:Name="ViewSettings" Visibility="Collapsed" Margin="34,24,34,24">
                        <Grid.RenderTransform>
                            <TranslateTransform Y="0"/>
                        </Grid.RenderTransform>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" PreviewMouseWheel="ScrollViewer_PreviewMouseWheel" PreviewMouseLeftButtonDown="ScrollViewer_PreviewMouseLeftButtonDown" PreviewKeyDown="ScrollViewer_PreviewKeyDown" RequestBringIntoView="ScrollViewer_RequestBringIntoView">
                            <StackPanel Margin="0,0,14,24">
                                <TextBlock x:Name="TxtTitleSettings" Text="Settings" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,20"/>

                                <!-- 0. Language Selector -->
                                <TextBlock x:Name="TxtSecLanguage" Text="Language / Язык интерфейса" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10"/>
                                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,24">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock x:Name="TxtLangTitle" Text="Application Language" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock x:Name="TxtLangDesc" Text="Choose between English (Default) and Russian" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <ComboBox x:Name="CmbLanguage" Grid.Column="1" Width="180" Height="34" VerticalAlignment="Center" SelectionChanged="CmbLanguage_SelectionChanged" SelectedIndex="0">
                                            <ComboBoxItem Content="English (Default)"/>
                                            <ComboBoxItem Content="Русский"/>
                                        </ComboBox>
                                    </Grid>
                                </Border>

                                <!-- 1. General Section -->
                                <TextBlock x:Name="TxtSecGeneral" Text="General" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10"/>
                                
                                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock x:Name="TxtPubTitle" Text="Auto-move Public Desktop items" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock x:Name="TxtPubDesc" Text="Automatically move items from Public Desktop to active desktop on switch" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkAutoMovePublic" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource ToggleSwitchStyle}" IsChecked="False" Click="ChkAutoMovePublic_Click"/>
                                    </Grid>
                                </Border>

                                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,24">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock x:Name="TxtDefFolderTitle" Text="Default desktop folder" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock x:Name="TxtDefFolderDesc" Text="Managed automatically by OS Desktop folder" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <Button x:Name="BtnBrowseDefault" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource SecondaryButtonStyle}" Click="BtnBrowseDefault_Click">
                                            <TextBlock x:Name="TxtBtnBrowse" Text="Browse" FontSize="13"/>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- 2. Personalization Section -->
                                <TextBlock x:Name="TxtSecPersonalization" Text="Personalization" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10"/>

                                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="TxtWpTitle" Text="Independent Wallpapers" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <Border Background="{StaticResource AccentTintBrush}" BorderBrush="{StaticResource AccentBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                                                    <TextBlock x:Name="TxtWpBadge" Text="INCLUDED" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock x:Name="TxtWpDesc" Text="FluxDesk manages distinct wallpapers per workspace." FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkIndependentWallpapers" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource ToggleSwitchStyle}" IsChecked="False" Click="ChkIndependentWallpapers_Click"/>
                                    </Grid>
                                </Border>

                                <!-- Switcher Preview Icons -->
                                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock x:Name="TxtPreviewIconsTitle" Text="Desktop icons on switcher previews" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock x:Name="TxtPreviewIconsDesc" Text="Show desktop icons on Alt+W preview cards, or keep cards showing only clean wallpapers." FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkShowPreviewIcons" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource ToggleSwitchStyle}" IsChecked="True" Click="ChkShowPreviewIcons_Click"/>
                                    </Grid>
                                </Border>

                                <!-- Wallpaper Engine Integration -->
                                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,24">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock x:Name="TxtWeTitle" Text="Wallpaper Engine Integration" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <Border Background="{StaticResource AccentTintBrush}" BorderBrush="{StaticResource AccentBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                                                        <TextBlock x:Name="TxtWeBadge" Text="LIVE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock x:Name="TxtWeDesc" Text="Automatically switch live wallpapers per workspace when switching." FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <CheckBox x:Name="ChkWallpaperEngine" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource ToggleSwitchStyle}" IsChecked="False" Click="ChkWallpaperEngine_Click"/>
                                        </Grid>
                                        <StackPanel Grid.Row="1" Margin="0,14,0,0">
                                            <TextBlock x:Name="TxtWePathLabel" Text="Executable path (wallpaper64.exe):" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="TxtWallpaperEngineExe" Height="36" Padding="10,0" FontSize="12" Background="#161922" BorderBrush="{StaticResource BorderBrush}" Foreground="{StaticResource TextPrimaryBrush}" VerticalContentAlignment="Center" TextChanged="TxtWallpaperEngineExe_TextChanged"/>
                                                <Button x:Name="BtnBrowseWallpaperEngine" Grid.Column="1" Height="36" Padding="14,0" Margin="10,0,0,0" Style="{StaticResource SecondaryButtonStyle}" Click="BtnBrowseWallpaperEngine_Click">
                                                    <TextBlock x:Name="TxtBtnBrowseWe" Text="Browse" FontSize="13"/>
                                                </Button>
                                            </Grid>
                                            <TextBlock x:Name="TxtWeStatus" Text="Status" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- 3. System Section -->
                                <TextBlock x:Name="TxtSecSystem" Text="System" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10"/>

                                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock x:Name="TxtStartupTitle" Text="Launch on startup" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock x:Name="TxtStartupDesc" Text="Automatically start when Windows starts" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkStartWithWindows" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource ToggleSwitchStyle}" IsChecked="True" Click="ChkStartWithWindows_Click"/>
                                    </Grid>
                                </Border>

                                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock x:Name="TxtRestoreShutdownTitle" Text="Restore Desktop 1 on shutdown/reboot" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock x:Name="TxtRestoreShutdownDesc" Text="Automatically return to your primary desktop when Windows shuts down or restarts." FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkRestorePrimaryOnShutdown" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource ToggleSwitchStyle}" IsChecked="True" Click="ChkRestorePrimaryOnShutdown_Click"/>
                                    </Grid>
                                </Border>

                                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock x:Name="TxtCtxMenuTitle" Text="Windows context menu integration" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock x:Name="TxtCtxMenuDesc" Text="Add commands to right-click menu" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkContextMenu" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource ToggleSwitchStyle}" IsChecked="False" Click="ChkContextMenu_Click"/>
                                    </Grid>
                                </Border>

                                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,24">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock x:Name="TxtTrayTitle" Text="Show tray icon" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock x:Name="TxtTrayDesc" Text="Show the FluxDesk icon in the system tray." FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkShowTrayIcon" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource ToggleSwitchStyle}" IsChecked="True" Click="ChkShowTrayIcon_Click"/>
                                    </Grid>
                                </Border>

                                <!-- 4. Keyboard Shortcuts Section -->
                                <TextBlock x:Name="TxtSecKeyboard" Text="Keyboard Shortcuts" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10"/>

                                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock x:Name="TxtQuickSwitcherTitle" Text="Quick Switcher" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock x:Name="TxtQuickSwitcherDesc" Text="Enable the quick switcher overlay for fast desktop switching" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkQuickSwitcher" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource ToggleSwitchStyle}" IsChecked="True" Click="ChkQuickSwitcher_Click"/>
                                    </Grid>
                                </Border>

                                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock x:Name="TxtQsForwardTitle" Text="Quick Switcher (Forward)" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock x:Name="TxtQsForwardDesc" Text="Cycle to next desktop" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" VerticalAlignment="Center" Background="#13171F" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16,8">
                                            <TextBlock Text="Alt + W" FontWeight="Bold" FontSize="13" Foreground="{StaticResource AccentBrush}"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,24">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock x:Name="TxtQsBackwardTitle" Text="Quick Switcher (Backward)" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock x:Name="TxtQsBackwardDesc" Text="Cycle to previous desktop" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" VerticalAlignment="Center" Background="#13171F" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16,8">
                                            <TextBlock Text="Alt + Q  /  Alt + Shift + W" FontWeight="Bold" FontSize="13" Foreground="{StaticResource AccentBrush}"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- 4.5 Reset Settings Section -->
                                <TextBlock x:Name="TxtSecResetSettings" Text="Reset Settings" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10"/>
                                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,24">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock x:Name="TxtResetSettingsTitle" Text="Reset Settings to Defaults" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock x:Name="TxtResetSettingsDesc" Text="Restores hotkeys, autostart, switchers and appearance to factory settings. Your desktops and files will remain untouched." FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <Button x:Name="BtnResetSettings" Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center" Padding="16,8" Click="BtnResetSettings_Click">
                                            <TextBlock x:Name="TxtBtnResetSettings" Text="Reset Defaults" FontSize="13" FontWeight="SemiBold"/>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- 5. Uninstall / Cleanup Section -->
                                <TextBlock x:Name="TxtSecUninstall" Text="Uninstall" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10"/>
                                <Border Background="{StaticResource CardBrush}" BorderBrush="#3D262B" BorderThickness="1" CornerRadius="10" Padding="18">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock x:Name="TxtUninstallTitle" Text="Uninstall FluxDesk" FontSize="14" FontWeight="SemiBold" Foreground="#FCA5A5"/>
                                            <TextBlock x:Name="TxtUninstallDesc" Text="Safely restores your primary Windows Desktop, removes autostart, and lets you save a backup folder of all workspaces on Desktop 1." FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Padding="16,8" Background="#2D161A" BorderBrush="#7F1D1D" BorderThickness="1" Cursor="Hand" VerticalAlignment="Center" Click="BtnOpenUninstall_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <TextBlock x:Name="TxtBtnUninstall" Text="Uninstall..." FontSize="13" FontWeight="SemiBold" Foreground="#FCA5A5"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- Tab 3: About View -->
                    <Grid x:Name="ViewAbout" Visibility="Collapsed" Margin="34,24,34,24">
                        <Grid.RenderTransform>
                            <TranslateTransform Y="0"/>
                        </Grid.RenderTransform>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" PreviewMouseWheel="ScrollViewer_PreviewMouseWheel" PreviewMouseLeftButtonDown="ScrollViewer_PreviewMouseLeftButtonDown" PreviewKeyDown="ScrollViewer_PreviewKeyDown" RequestBringIntoView="ScrollViewer_RequestBringIntoView">
                            <StackPanel Margin="0,0,14,24">
                                <TextBlock x:Name="TxtTitleAbout" Text="About FluxDesk" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,24"/>
                                
                                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="26" Margin="0,0,0,16">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                            <Image Source="logo.png" Width="44" Height="44" Margin="0,0,16,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="FluxDesk" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock x:Name="TxtAboutVersion" Text="Version 2.0.0 (x64 Release)" FontSize="13" Foreground="{StaticResource AccentBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock x:Name="TxtAboutDesc" Text="Independent, free &amp; private desktop workspace manager for Windows 10 &amp; 11." FontSize="13.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,16"/>
                                        <TextBlock x:Name="TxtAboutF1" Text="• Free &amp; Open Source: No paywalls, no ads, unlimited workspaces." FontSize="13" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                        <TextBlock x:Name="TxtAboutF2" Text="• 100% Private &amp; Local: No servers, no tracking, zero telemetry." FontSize="13" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                        <TextBlock x:Name="TxtAboutF3" Text="• Native Shell Integration: Clean Win32 shell redirection." FontSize="13" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- Author, Contact & GitHub Repository Card -->
                                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="24">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtContactTitle" Text="Author &amp; Links" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                        <TextBlock x:Name="TxtContactDesc" Text="Found a bug, have feedback, or need to reach the author for any inquiries? Contact directly:" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,18"/>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                            <TextBlock x:Name="TxtTgLabel" Text="Telegram:" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBox Text="@l1vensi" IsReadOnly="True" Background="Transparent" BorderThickness="0" Foreground="{StaticResource AccentBrush}" CaretBrush="{StaticResource AccentBrush}" SelectionBrush="#254660" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" Padding="0"/>
                                        </StackPanel>

                                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,4,0,14"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtRepoLabel" Text="GitHub Repository" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock x:Name="TxtRepoStatus" Text="Repository link coming soon" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <Button x:Name="BtnOpenRepo" Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Padding="16,7" Click="BtnOpenRepo_Click" IsEnabled="False" Opacity="0.6">
                                                <TextBlock x:Name="TxtBtnOpenRepo" Text="Coming soon" FontSize="12.5"/>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Modal Overlay for Renaming Desktops -->
            <Grid x:Name="RenameModalOverlay" Grid.RowSpan="2" Background="#A5000000" Visibility="Collapsed" KeyDown="RenameModal_KeyDown" KeyboardNavigation.TabNavigation="Cycle">
                <Border Background="{StaticResource CardBrush}" 
                        BorderBrush="{StaticResource AccentBorderBrush}" 
                        BorderThickness="1.5" 
                        CornerRadius="12" 
                        Width="440" 
                        VerticalAlignment="Center" 
                        HorizontalAlignment="Center" 
                        Padding="26">
                    <StackPanel>
                        <!-- Modal Header -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Border Background="{StaticResource AccentTintBrush}" Width="32" Height="32" CornerRadius="8" Margin="0,0,12,0">
                                <Path Data="{StaticResource IconEdit}" Fill="{StaticResource AccentBrush}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="TxtRenameTitle" Text="Rename Workspace" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock x:Name="TxtRenameSubtitle" Text="Enter a new name for this workspace" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Input field -->
                        <Border Background="{StaticResource InputBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                            <TextBox x:Name="TxtRenameInput" 
                                     MaxLength="60"
                                     Background="Transparent" 
                                     BorderThickness="0" 
                                     Foreground="{StaticResource TextPrimaryBrush}" 
                                     FontSize="14" 
                                     FontWeight="Medium"
                                     CaretBrush="{StaticResource AccentBrush}"
                                     KeyDown="TxtRenameInput_KeyDown"/>
                        </Border>

                        <TextBlock x:Name="TxtRenamePathInfo" Text="" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,20" TextTrimming="CharacterEllipsis"/>

                        <!-- Action Buttons -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnRenameCancel" Click="BtnRenameCancel_Click" Margin="0,0,10,0" Style="{StaticResource SecondaryButtonStyle}" Content="Cancel"/>
                            <Button x:Name="BtnRenameSave" Click="BtnRenameSave_Click" Style="{StaticResource AccentButtonStyle}" Content="Save"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
            <!-- Custom Dark Modal Overlay for Deleting Desktop(s) -->
            <Grid x:Name="DeleteModalOverlay" Grid.RowSpan="2" Background="#B0000000" Visibility="Collapsed" KeyboardNavigation.TabNavigation="Cycle">
                <Border Background="{StaticResource CardBrush}"
                        BorderBrush="#3D262B"
                        BorderThickness="1.5"
                        CornerRadius="12"
                        Width="460"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Padding="26">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Background="#2D161A" BorderBrush="#5C242B" BorderThickness="1" Width="36" Height="36" CornerRadius="8" Margin="0,0,12,0">
                                <Path Data="{StaticResource IconClose}" Fill="#F87171" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="TxtDeleteTitle" Text="Delete Desktop" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock x:Name="TxtDeleteSubtitle" Text="Confirm removal" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock x:Name="TxtDeleteMessage" Text="" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>

                        <!-- Optional Delete Files to Recycle Bin toggle -->
                        <Border Background="#13171F" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,22">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock x:Name="TxtDeleteFilesTitle" Text="Also delete folders &amp; files" FontSize="13" FontWeight="SemiBold" Foreground="#FCA5A5"/>
                                    <TextBlock x:Name="TxtDeleteFilesDesc" Text="Moves desktop folders to the Windows Recycle Bin (recoverable). Leave off to keep all files safe on disk." FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                                <CheckBox x:Name="ChkDeleteFilesToRecycle" Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" IsChecked="False" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnDeleteCancel" Click="BtnDeleteCancel_Click" Margin="0,0,10,0" Style="{StaticResource SecondaryButtonStyle}" Content="Cancel"/>
                            <Button x:Name="BtnDeleteConfirm" Click="BtnDeleteConfirm_Click" Style="{StaticResource DangerButtonStyle}" Content="Delete"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
            <!-- Custom Dark Modal Overlay for Hotkey Conflict Confirmation -->
            <Grid x:Name="ConflictModalOverlay" Grid.RowSpan="2" Background="#B0000000" Visibility="Collapsed" KeyboardNavigation.TabNavigation="Cycle">
                <Border Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource AccentBorderBrush}"
                        BorderThickness="1.5"
                        CornerRadius="12"
                        Width="440"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Padding="26">
                    <StackPanel>
                        <TextBlock x:Name="TxtConflictTitle" Text="Hotkey already assigned" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                        <TextBlock x:Name="TxtConflictMessage" Text="" FontSize="13.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,22"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnConflictCancel" Click="BtnConflictCancel_Click" Margin="0,0,10,0" Style="{StaticResource SecondaryButtonStyle}" Content="Cancel"/>
                            <Button x:Name="BtnConflictConfirm" Click="BtnConflictConfirm_Click" Style="{StaticResource AccentButtonStyle}" Content="Replace"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Custom Dark Modal Overlay for Uninstalling FluxDesk with Backup Option -->
            <Grid x:Name="UninstallModalOverlay" Grid.RowSpan="2" Background="#B8000000" Visibility="Collapsed" KeyboardNavigation.TabNavigation="Cycle">
                <Border Background="{StaticResource CardBrush}"
                        BorderBrush="#5C242B"
                        BorderThickness="1.5"
                        CornerRadius="12"
                        Width="480"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Padding="26">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Background="#2D161A" BorderBrush="#7F1D1D" BorderThickness="1" Width="36" Height="36" CornerRadius="8" Margin="0,0,12,0">
                                <Path Data="{StaticResource IconClose}" Fill="#F87171" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="TxtUninstallModalTitle" Text="Uninstall FluxDesk" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock x:Name="TxtUninstallModalSub" Text="Before removing the application" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock x:Name="TxtUninstallModalMsg" Text="FluxDesk will safely restore your main Windows Desktop (Desktop 1), remove autostart &amp; context menu entries, and close." FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                        <Border Background="#13171F" BorderBrush="{StaticResource AccentBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,22">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock x:Name="TxtBackupChoiceTitle" Text="Save backup folder on Desktop 1" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                    <TextBlock x:Name="TxtBackupChoiceDesc" Text="Creates 'FluxDesk Backup' on your primary Desktop with all secondary workspace folders, files, and last saved icon layouts." FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                                <CheckBox x:Name="ChkBackupBeforeUninstall" Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" IsChecked="True" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnUninstallCancel" Click="BtnUninstallCancel_Click" Margin="0,0,10,0" Style="{StaticResource SecondaryButtonStyle}" Content="Cancel"/>
                            <Button x:Name="BtnUninstallConfirm" Click="BtnUninstallConfirm_Click" Style="{StaticResource DangerButtonStyle}" Content="Uninstall FluxDesk"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
