        <SolidColorBrush x:Key="BgDarkBrush" Color="#0B0F15"/>
        <SolidColorBrush x:Key="SidebarBrush" Color="#10151E"/>
        <SolidColorBrush x:Key="CardBrush" Color="#151C26"/>
        <SolidColorBrush x:Key="CardHoverBrush" Color="#1C2533"/>
