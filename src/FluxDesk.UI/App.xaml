        <SolidColorBrush x:Key="TextMutedBrush" Color="#55657E"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#38BDF8"/>
        <SolidColorBrush x:Key="InputBgBrush" Color="#0D1219"/>

